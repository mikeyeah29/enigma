{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "color": {
            "palette": [
                { "name": "Soft Sage", "slug": "primary", "color": "#8FAF9A" },
				{ "name": "Deep Teal", "slug": "secondary", "color": "#2F5D62" },
                { "name": "Muted Clay", "slug": "accent", "color": "#C48A6A" },
                { "name": "Soft Lavender", "slug": "accent-2", "color": "#B6A6C9" },
                { "name": "Stone Grey", "slug": "neutral", "color": "#E2E0DA" },
                { "name": "Warm Off White", "slug": "background", "color": "#F6F4EF" },
                { "name": "White", "slug": "white", "color": "#FFFFFF" },
                { "name": "Charcoal", "slug": "text", "color": "#2E2E2E" },
                { "name": "Transparent", "slug": "transparent", "color": "transparent" }
            ],
            "defaultPalette": false,
            "defaultGradients": false,
            "custom": true
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "\"Polymath\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
                    "name": "Polymath",
                    "slug": "body"
                },
                {
                    "fontFamily": "\"Ivy Presto Text\", Georgia, \"Times New Roman\", serif",
                    "name": "Ivy Presto Text",
                    "slug": "heading"
                },
                {
                    "fontFamily": "cursive",
                    "name": "Script",
                    "slug": "script"
                }
            ],
            "fluid": true,
            "defaultFontSizes": false,
            "fontSizes": [
                {
                    "slug": "sm",
                    "name": "Small",
                    "size": "clamp(14px, 1.25rem + 0.4vw, 18px)"
                },
                {
                    "slug": "md",
                    "name": "Medium",
                    "size": "clamp(18px, 1rem + 1vw, 24px)"
                },
                {
                    "slug": "lg",
                    "name": "Large",
                    "size": "clamp(24px, 1rem + 2vw, 32px)"
                },
                {
                    "slug": "xl",
                    "name": "Extra Large",
                    "size": "clamp(32px, 1.2rem + 2.5vw, 48px)"
                },
                {
                    "slug": "hero",
                    "name": "Hero",
                    "size": "clamp(40px, 1.5rem + 3vw, 64px)"
                }
            ],
            "dropCap": false
        },
        "spacing": {
            "padding": true,
            "customSpacingSize": true,
            "defaultSpacingSizes": false,
            "units": [
                "px",
                "em",
                "rem",
                "%"
            ],
            "spacingScale": {
                "steps": 0
            },
            "spacingSizes": [
                {
                    "slug": "none",
                    "name": "None",
                    "size": "0px"
                },
                {
                    "slug": "xs",
                    "name": "Extra Small",
                    "size": "clamp(12px, 1.7vw, 24px)"
                },
                {
                    "slug": "sm",
                    "name": "Small",
                    "size": "clamp(18px, 2.6vw, 36px)"
                },
                {
                    "slug": "md",
                    "name": "Medium",
                    "size": "clamp(24px, 3.4vw, 48px)"
                },
                {
                    "slug": "lg",
                    "name": "Large",
                    "size": "clamp(48px, 8vw, 80px)"
                },
                {
                    "slug": "xl",
                    "name": "Extra Large",
                    "size": "clamp(64px, 9vw, 126px)"
                }
            ]
        },
        "layout": {
            "contentSize": "960px",
            "wideSize": "1180px"
        }
    },
    "styles": {
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "16px",
            "lineHeight": 1.6
        },
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--text)"
        },
        "spacing": {
            "blockGap": "1.5rem"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--secondary)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--text)"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--secondary)",
                    "text": "var(--wp--preset--color--white)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontWeight": "600"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--text)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontWeight": "700",
                    "lineHeight": 1.2
                }
            }
        },
        "blocks": {
            "core/group": {
                "spacing": {
                    "padding": {
                        "top": "clamp(48px, 8vw, 80px)",
                        "bottom": "clamp(48px, 8vw, 80px)",
                        "left": "2rem",
                        "right": "2rem"
                    }
                }
            },
            "enigma/testimonial-slider": {
                "spacing": {
                    "padding": {
                        "top": "clamp(48px, 8vw, 80px)",
                        "bottom": "clamp(48px, 8vw, 80px)"
                    }
                }
            }
        }
    },
    "customTemplates": [],
    "templateParts": []
}
