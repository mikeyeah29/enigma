{
    "apiVersion": 3,
    "name": "enigma/post-slider",
    "title": "Post Slider",
    "category": "design",
    "icon": "slides",
    "description": "A slider displaying posts from a selected post type.",
    "attributes": {
        "postType": {
            "type": "string",
            "default": "post"
        },
        "limit": {
            "type": "number",
            "default": 6
        },
        "slidesToShow": {
            "type": "number",
            "default": 3
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "script": "file:./frontend.js",
    "render": "file:./render.php",
    "supports": {
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "padding": true
        },
        "html": false
    }
}
